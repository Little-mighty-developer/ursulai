// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "debian-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String          @id @default(uuid())
  email                String          @unique
  firstName            String?
  lastLogin            DateTime?
  lastActive           DateTime?
  onboardingCompletedAt DateTime?
  activities           Activity[]
  loginHistory         LoginHistory[]
  preferences          UserPreference?
}

model UserPreference {
  id                   String   @id @default(uuid())
  user                 User     @relation(fields: [userId], references: [id])
  userId               String   @unique
  intentions           String[] // multi-select: gentle reflection, patterns, etc.
  energyPreference     String?  // simple, guidance, structure
  checkInStyle         String?  // visual, writing, thinking, changes
  trackingPreference   String?  // patterns, gentle, no pressure, see how
  cycleTrackingEnabled         Boolean  @default(false)
  typicalCycleLength           Int      @default(28) // fallback until enough period logs
  cycleBackfillOfferConsumed   Boolean  @default(false) // one-time bulk paste on cycle log
  createdAt                    DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model CyclePeriodStart {
  id        String   @id @default(uuid())
  userId    String
  startDate DateTime @db.Date
  notes     String?
  createdAt DateTime @default(now())

  @@index([userId, startDate(sort: Desc)])
}

model Activity {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  date      DateTime
  checkin   Boolean  @default(false)
  mood      Boolean  @default(false)
  reminder  Boolean  @default(false)
  journal   Boolean  @default(false)
}

model MoodEntry {
  id        String   @id @default(uuid())
  userId    String
  valence   Float    // -1.0 (unpleasant) to 1.0 (pleasant)
  arousal   Float    // -1.0 (low energy) to 1.0 (high energy)
  region    Int      // 0-7, the petal region ID
  clickX    Float?   // Optional: X coordinate of click position
  clickY    Float?   // Optional: Y coordinate of click position
  notes     String?  // Optional: User's notes about their mood
  createdAt DateTime @default(now())
  
  @@index([userId, createdAt])
}

model SymptomEvent {
  id         Int      @id @default(autoincrement())
  userId     String
  symptomKey String
  eventType  String // "on" or "off"
  timestamp  DateTime @default(now())
}

model DailyNote {
  id        String   @id @default(uuid())
  userId    String
  content   String
  date      DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date]) // Each user can have only one note per day
}

model JournalEntry {
  id        String   @id @default(uuid())
  userId    String
  content   String
  date      DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GratitudeEntry {
  id        String   @id @default(uuid())
  userId    String
  content   String
  date      DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LoginHistory {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  loginDate DateTime @default(now())
  
  @@unique([userId, loginDate]) // One login record per user per day
  @@index([userId, loginDate])
}

