{
  "name": "ursulai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "prepare": "husky install",
    "db:generate": "dotenv -e .env -e .env.local -o -- prisma generate",
    "db:migrate": "dotenv -e .env -e .env.local -o -- prisma migrate dev",
    "db:migrate:deploy": "dotenv -e .env -e .env.local -o -- prisma migrate deploy",
    "db:studio": "dotenv -e .env -e .env.local -o -- prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^6.7.0",
    "next": "^15.3.6",
    "next-auth": "^4.24.11",
    "openai": "^6.22.0",
    "react": "^19.0.1",
    "react-calendar": "^5.1.0",
    "react-dom": "^19.0.1",
    "react-masonry-css": "^1.0.16"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@eslint/js": "^9.27.0",
    "@netlify/plugin-nextjs": "^5.15.3",
    "@next/eslint-plugin-next": "^15.3.6",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.27.0",
    "eslint-config-next": "^15.3.6",
    "eslint-plugin-next": "^0.0.0",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^16.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.0.0",
    "prettier": "^3.5.3",
    "prisma": "^6.7.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8.32.1"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,md,json}": [
      "prettier --write"
    ]
  },
  "eslintConfig": {
    "extends": [
      "next/core-web-vitals",
      "plugin:react/jsx-runtime"
    ]
  }
}
