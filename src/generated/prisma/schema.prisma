// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "debian-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String          @id @default(uuid())
  email                 String          @unique
  firstName             String?
  lastLogin             DateTime?
  lastActive            DateTime?
  onboardingCompletedAt DateTime?
  activities            Activity[]
  loginHistory          LoginHistory[]
  preferences           UserPreference?
}

model UserPreference {
  id                         String   @id @default(uuid())
  user                       User     @relation(fields: [userId], references: [id])
  userId                     String   @unique
  intentions                 String[] // multi-select: gentle reflection, patterns, etc.
  energyPreference           String? // simple, guidance, structure
  checkInStyle               String? // visual, writing, thinking, changes
  trackingPreference         String? // patterns, gentle, no pressure, see how
  cycleTrackingEnabled       Boolean  @default(false)
  typicalCycleLength         Int      @default(28) // fallback until enough period logs
  cycleBackfillOfferConsumed Boolean  @default(false) // one-time bulk paste on cycle log
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
}

model CyclePeriodStart {
  id        String   @id @default(uuid())
  userId    String
  startDate DateTime @db.Date
  notes     String?
  createdAt DateTime @default(now())

  @@index([userId, startDate(sort: Desc)])
}

model Activity {
  id       String   @id @default(uuid())
  user     User     @relation(fields: [userId], references: [id])
  userId   String
  date     DateTime
  checkin  Boolean  @default(false)
  mood     Boolean  @default(false)
  reminder Boolean  @default(false)
  journal  Boolean  @default(false)
}

model MoodEntry {
  id        String   @id @default(uuid())
  userId    String
  valence   Float // -1.0 (difficult) to 1.0 (good)
  arousal   Float // -1.0 (drained) to 1.0 (energised)
  region    Int? // Legacy: petal region ID from old flower selector
  clickX    Float? // Legacy: X coordinate from old flower selector
  clickY    Float? // Legacy: Y coordinate from old flower selector
  notes     String? // Optional: User's notes about their mood
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model SymptomEvent {
  id         Int      @id @default(autoincrement())
  userId     String
  symptomKey String
  eventType  String // "on" or "off"
  timestamp  DateTime @default(now())
}

model BodyActivity {
  id        String   @id @default(uuid())
  key       String   @unique
  label     String
  emoji     String?
  tags      String[] // e.g. gentle, intense, social, outdoors, grounding
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BodyActivityLog {
  id            String   @id @default(uuid())
  userId        String
  activityKey   String
  activityLabel String
  activityEmoji String?
  symptomKeys   String[] // snapshot at selection time
  skipped       Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, activityKey, createdAt(sort: Desc)])
}

model DailyNote {
  id        String   @id @default(uuid())
  userId    String
  content   String
  date      DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date]) // Each user can have only one note per day
}

model JournalEntry {
  id        String   @id @default(uuid())
  userId    String
  content   String
  date      DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GratitudeEntry {
  id        String   @id @default(uuid())
  userId    String
  content   String
  date      DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Win {
  id        String   @id @default(uuid())
  userId    String
  content   String
  date      DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, date(sort: Desc)])
}

model ProgressPhoto {
  id        String   @id @default(uuid())
  userId    String
  dataUrl   String // downscaled base64 data URL
  caption   String?
  date      DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([userId, date(sort: Desc)])
}

model Measurement {
  id        String   @id @default(uuid())
  userId    String
  label     String // e.g. "Waist", "Weight" — user-defined
  value     Float
  unit      String? // e.g. "cm", "kg"
  date      DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([userId, date(sort: Desc)])
}

model LoginHistory {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  loginDate DateTime @default(now())

  @@unique([userId, loginDate]) // One login record per user per day
  @@index([userId, loginDate])
}
